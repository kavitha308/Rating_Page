# ==============================================================================
# STORE RATING PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to server/.env and adjust values for your environment
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Engine Selection:
# Set to 'true' for zero-config in-memory testing (no MySQL server required)
# Set to 'false' to connect to local/cloud MySQL 8.0+
USE_SQLITE=true

# MySQL 8.0+ Configuration (used when USE_SQLITE=false)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=store_rating_db
DB_CONNECTION_LIMIT=10

# JWT Token Security (Use a cryptographically random string in production)
JWT_SECRET=super_secret_jwt_key_store_rating_platform_2026_xyz
JWT_EXPIRES_IN=24h

# Rate Limiter Controls
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX_REQUESTS=1000
